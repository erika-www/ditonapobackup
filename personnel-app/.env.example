# Browser-visible values: use only the Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TEST DEPLOYMENTS ONLY. Removes personnel/admin login requirements and expects
# the public test-access Supabase migration to be applied. Never enable this
# against a production database containing real user or operational data.
VITE_ENABLE_TEST_MODE=true

# Public backend URL for the admin API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional browser-visible key; restrict by allowed origins and APIs in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

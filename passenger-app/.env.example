# Browser-visible values: use only the Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TEST DEPLOYMENTS ONLY. Defaults to enabled when omitted. Set to false before
# using real passenger accounts or production data.
VITE_ENABLE_TEST_MODE=true

# Canonical browser URL used after Google/Facebook sign-in (must also be allowed in Supabase Auth URL settings).
VITE_PASSENGER_APP_URL=http://localhost:5173

# Public backend URL for passenger API reads.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional browser-visible key; restrict by allowed origins and APIs in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
